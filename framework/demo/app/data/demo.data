/* framework/demo/app/data/demo.data
 * Interacts with: framework/server.js (discoverBracketsApp, invokeModuleMethod),
 *   framework/demo/index.html Live tab (:run read + rpc append/update).
 *
 * Demo persistence: SQLite file via host storage.db() → key/value rows in brackets_store.
 */

const STORE_KEY = 'demo_events';

function normalizePayload(input) {
  return {
    text: String(input?.text ?? '').trim() || 'demo row'
  };
}

async function loadRows(db) {
  const raw = await db.read([], { key: STORE_KEY });
  return Array.isArray(raw) ? raw : [];
}

async function saveRows(db, rows) {
  await db.write(rows, { key: STORE_KEY });
  return rows;
}

({
  async events({ storage }) {
    const db = storage.db('@storage/demo.db');
    const events = await loadRows(db);
    return {
      events,
      updatedAt: new Date().toISOString()
    };
  },

  async append({ storage }, payload) {
    const db = storage.db('@storage/demo.db');
    const clean = normalizePayload(payload);
    const events = await loadRows(db);
    const row = {
      id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
      text: clean.text,
      at: new Date().toISOString()
    };
    events.push(row);
    const next = events.length > 80 ? events.slice(-80) : events;
    await saveRows(db, next);
    return { ok: true, row };
  },

  async update({ storage }, payload) {
    const id = String(payload?.id ?? '').trim();
    const text = String(payload?.text ?? '').trim();
    if (!id) {
      const error = new Error('Row id is required.');
      error.code = 'DEMO_INVALID';
      throw error;
    }
    if (!text) {
      const error = new Error('Note text is required.');
      error.code = 'DEMO_INVALID';
      throw error;
    }
    const db = storage.db('@storage/demo.db');
    const events = await loadRows(db);
    const index = events.findIndex((entry) => entry.id === id);
    if (index === -1) {
      const error = new Error('That note is no longer in the list.');
      error.code = 'DEMO_NOT_FOUND';
      throw error;
    }
    const previous = events[index];
    events[index] = {
      ...previous,
      text,
      at: new Date().toISOString()
    };
    await saveRows(db, events);
    return { ok: true, row: events[index] };
  }
})
