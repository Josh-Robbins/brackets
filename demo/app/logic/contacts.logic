({
  async mount({ data, state }) {
    const contacts = await data.contacts.list()
    state.set({
      contacts,
      draftName: '',
      draftSource: 'desktop'
    })
  },

  async addContact({ data, state, action }) {
    const form = action.input() ?? {}
    const name = (form.name ?? '').trim()
    const source = (form.source ?? 'desktop').trim()

    if (!name) {
      return
    }

    const current = state.get().contacts ?? []
    const next = [
      ...current,
      {
        id: Date.now(),
        name,
        source
      }
    ]

    await data.contacts.save(next)
    state.set({
      contacts: next,
      draftName: '',
      draftSource: 'desktop'
    })
  },

  async reload({ data, state }) {
    const contacts = await data.contacts.list()
    state.set({ contacts })
  }
})
